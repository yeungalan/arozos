/*
	Office Viewer - Modern office file viewer
*/

var moduleLaunchInfo = {
    Name: "OfficeViewer",
	Desc: "Modern office file viewer for documents, spreadsheets and presentations",
	Group: "Office",
	IconPath: "OfficeViewer/img/module_icon.png",
	Version: "2.0",
	StartDir: "OfficeViewer/index.html",
	SupportFW: true,
	InitFWSize: [320, 210],
	LaunchFWDir: "OfficeViewer/index.html",
	SupportEmb: true,
	LaunchEmb: "OfficeViewer/embedded.html",
	InitEmbSize: [1060, 680],
	SupportedExt: [
		".docx", ".pptx", ".xlsx", ".csv",
		".pdf", ".xls", ".ods", ".odp",
		".jpg", ".jpeg", ".png", ".gif", ".svg", ".webp", ".bmp"
	]
}

registerModule(JSON.stringify(moduleLaunchInfo));
