/*
    Office Viewer — Modern office document viewer
    Supports: DOCX, XLSX, PPTX with server-side OOXML parsing
*/

var moduleLaunchInfo = {
    Name: "OfficeViewer",
    Desc: "Modern office document viewer for DOCX, XLSX and PPTX",
    Group: "Office",
    IconPath: "OfficeViewer/img/module_icon.png",
    Version: "2.0",
    StartDir: "OfficeViewer/index.html",
    SupportFW: true,
    InitFWSize: [380, 240],
    LaunchFWDir: "OfficeViewer/index.html",
    SupportEmb: true,
    LaunchEmb: "OfficeViewer/embedded.html",
    InitEmbSize: [1200, 780],
    SupportedExt: [".docx", ".pptx", ".xlsx", ".xlsm", ".pptm"]
}

registerModule(JSON.stringify(moduleLaunchInfo));
