/*
    Inventory Module Register Script

    Barcode-driven inventory control, laid out for a rugged handheld terminal
    (Panasonic Toughbook FZ-N1 and similar keyboard-wedge scanners).
*/

var moduleLaunchInfo = {
    Name: "Inventory",
    Desc: "Barcode inventory control with expiry, warranty, price and location tracking",
    Group: "Office",
    IconPath: "img/module_icon.svg",
    Version: "1.0",
    StartDir: "index.html",
    SupportFW: true,
    LaunchFWDir: "index.html",
    SupportEmb: false,
    InitFWSize: [480, 800],
    SupportedExt: []
}

registerModule(JSON.stringify(moduleLaunchInfo));
