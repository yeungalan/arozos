/*
    AI Assistant (Daily Briefing) — ArozOS AGI Serverless Function
    ===============================================================

    A single-file port of the "AI Assistiant" n8n workflow to the ArozOS AGI
    serverless runtime. Host it with the Serverless webapp and trigger it every
    morning (external cron or the AGI scheduler) by hitting its endpoint:

        https://<your-host>/api/remote/<UUID>

    What the workflow did
    ---------------------
      Holiday + personal + work calendars ->  gatherCalendar()  (now via .ics)
      Trello board -> lists/cards         ->  gatherTrello()
      Aggr (Code node)                    ->  buildAggregate()  (same text layout)
      Message a model                     ->  llm.chat()        (zh-TW digest)
      Send a text message                 ->  sendMessage()     (Telegram)
      Wait 20h -> Delete message          ->  pending-deletion queue (cleanup())

    Calendars via ICS (no OAuth needed)
    -----------------------------------
    The AGI `http` library's GET cannot set request headers, so instead of the
    Google Calendar API this build reads each calendar's public/secret **iCal
    (.ics) feed** — a plain URL that `http.get` can fetch directly. Get the URL
    from Google Calendar > Settings > "Secret address in iCal format" (private
    calendars) or "Public address in iCal format" (holiday calendars).

    The built-in ICS parser handles line folding, all-day (VALUE=DATE) and timed
    events (UTC "Z" or TZID). Note: it does not expand RRULE recurring events, so
    a recurring event only appears on its original DTSTART day — list concrete
    occurrences in the feed, or drop such events into a dedicated calendar.

    Trello uses its normal key+token query-parameter auth, so it works directly.

    Author: converted from n8n workflow "AI Assistiant"
*/

requirelib("http");
requirelib("llm");

// ── Configuration ───────────────────────────────────────────────────────────
var CONFIG = {
    // Telegram bot token (from @BotFather). Leave "" to read it from the AGI DB
    // item AIAssistant/botToken instead.
    botToken: "",
    chatId: "184782124", // the original personal chat id

    // Timezone used both for the "today" window and for displaying event times.
    tzOffsetHours: -7,       // Pacific (PDT). Use -8 for PST, +9 for Tokyo, etc.
    tzLabel: "Pacific Time",

    // Trello (key + token from https://trello.com/app-key). boardId is the
    // board's short id or full id.
    trello: {
        enabled: true,
        apiKey: "",
        token: "",
        boardId: ""
    },

    // Calendars to pull today's events/holidays from, each an iCal .ics URL.
    // `kind` controls the section and line prefix: "holiday", "event" or "work".
    calendars: [
        { enabled: true, kind: "event", label: "Personal",
          ics: "https://calendar.google.com/calendar/ical/yeungbluecat123%40gmail.com/private-ff992be9c3c1072cabbfe5681e8341bf/basic.ics" },
        { enabled: true, kind: "holiday", label: "US",
          ics: "https://calendar.google.com/calendar/ical/en.usa%23holiday%40group.v.calendar.google.com/public/basic.ics" },
        { enabled: true, kind: "holiday", label: "JP",
          ics: "https://calendar.google.com/calendar/ical/en.japanese%23holiday%40group.v.calendar.google.com/public/basic.ics" }
    ],

    // LLM settings. model === "" uses the server's configured default model.
    model: "",
    maxTokens: 2000,
    // The instruction block from the workflow's "Message a model" node. The
    // aggregated briefing text is appended after it.
    promptTemplate:
        "查看我今天的行事曆和任務清單。請提供：\n\n" +
        "今日狀態：告訴我今天是否為假日或特殊日子，以及我行事曆上有什麼安排\n" +
        "今日待辦事項：列出今天到期或已逾期的任務\n" +
        "進行中的工作：強調我 Trello 看板上目前正在進行、需要關注的項目\n" +
        "重要提醒：標記接下來 3-7 天內任何時間敏感的事項（即將到期的截止日期、活動或承諾）\n\n" +
        "保持簡潔且可執行。按緊急性和重要性排序。\n格式要求：\n\n" +
        "全部內容必須使用繁體中文（zh-TW）輸出\n" +
        "條列項目使用「•」符號，不要使用星號或其他符號\n適合在 Telegram 顯示\n\n" +
        "僅輸出純文字條列，不含前言或結語。\n\n",

    // Telegram parse mode: "" (plain, most reliable), "MarkdownV2" or "HTML".
    parseMode: "",

    // Auto-cleanup: delete each sent briefing this long after it was posted.
    // Handled as a pending-deletion queue drained on each run (the endpoint is
    // hit daily), replacing the workflow's inline "Wait 20h -> Delete" branch.
    deleteAfterMs: 20 * 60 * 60 * 1000,

    dbTable: "AIAssistant"
};

var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
              "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
var WEEKDAYS = ["Sunday", "Monday", "Tuesday", "Wednesday",
                "Thursday", "Friday", "Saturday"];

// ── Generic helpers ─────────────────────────────────────────────────────────

function getBotToken() {
    if (CONFIG.botToken && CONFIG.botToken !== "") {
        return CONFIG.botToken;
    }
    var stored = readDBItem(CONFIG.dbTable, "botToken");
    if (stored && stored !== "false" && stored !== "null") {
        return stored;
    }
    return "";
}

function telegramApi(token, method, payload) {
    var url = "https://api.telegram.org/bot" + token + "/" + method;
    var raw = http.post(url, JSON.stringify(payload));
    if (raw === null) {
        return { ok: false, error: "no response from Telegram API" };
    }
    try {
        return JSON.parse(raw);
    } catch (e) {
        return { ok: false, error: "unparsable Telegram response", raw: raw };
    }
}

function escapeMarkdownV2(text) {
    return String(text).replace(/([_*\[\]()~`>#+\-=|{}.!\\])/g, "\\$1");
}

// ── Date/time formatting (Intl-free, tz-offset based) ───────────────────────
// Otto lacks Intl, so timezone display is done by shifting epoch ms by the
// configured offset and reading UTC components off the shifted instant.

function shifted(ms) {
    var d = new Date(ms + CONFIG.tzOffsetHours * 3600000);
    return {
        y: d.getUTCFullYear(), mo: d.getUTCMonth(), d: d.getUTCDate(),
        h: d.getUTCHours(), mi: d.getUTCMinutes(), wd: d.getUTCDay()
    };
}

function pad2(n) { return n < 10 ? "0" + n : "" + n; }

function fmtTime(p) {
    var h = p.h % 12; if (h === 0) h = 12;
    var ap = p.h < 12 ? "AM" : "PM";
    return h + ":" + pad2(p.mi) + " " + ap;
}

function fmtDate(p) { return MONTHS[p.mo] + " " + p.d + ", " + p.y; }

// ── ICS parsing ─────────────────────────────────────────────────────────────

function unescapeICS(v) {
    return String(v)
        .replace(/\\n/gi, "\n").replace(/\\,/g, ",")
        .replace(/\\;/g, ";").replace(/\\\\/g, "\\");
}

// Parse an ICS DTSTART/DTEND value into { allDay, y, mo, d, [h, mi], ms }.
// Times ending in "Z" are UTC; naive/TZID times are approximated in the
// configured display timezone (correct when your calendar's tz matches it).
function parseICSDate(value, params) {
    value = value.replace(/\s+$/, "");
    var isDate = (/VALUE=DATE/i.test(params)) || /^\d{8}$/.test(value);
    var y = parseInt(value.substr(0, 4), 10);
    var mo = parseInt(value.substr(4, 2), 10) - 1;
    var d = parseInt(value.substr(6, 2), 10);
    if (isDate) {
        return { allDay: true, y: y, mo: mo, d: d };
    }
    var h = parseInt(value.substr(9, 2), 10);
    var mi = parseInt(value.substr(11, 2), 10);
    var s = parseInt(value.substr(13, 2) || "0", 10);
    var ms;
    if (value.charAt(value.length - 1) === "Z") {
        ms = Date.UTC(y, mo, d, h, mi, s);
    } else {
        ms = Date.UTC(y, mo, d, h, mi, s) - CONFIG.tzOffsetHours * 3600000;
    }
    return { allDay: false, y: y, mo: mo, d: d, ms: ms };
}

// Parse an ICS document into an array of { summary, location, start, end }.
// Only VEVENT blocks are read; VTIMEZONE and other components are ignored.
function parseICS(text) {
    // Unfold continuation lines (a CRLF/LF followed by a space or tab).
    text = text.replace(/\r\n[ \t]/g, "").replace(/\n[ \t]/g, "");
    var lines = text.split(/\r\n|\n|\r/);
    var events = [];
    var cur = null;
    for (var i = 0; i < lines.length; i++) {
        var line = lines[i];
        if (line === "BEGIN:VEVENT") {
            cur = {};
        } else if (line === "END:VEVENT") {
            if (cur) events.push(cur);
            cur = null;
        } else if (cur) {
            var idx = line.indexOf(":");
            if (idx < 0) continue;
            var left = line.slice(0, idx);
            var value = line.slice(idx + 1);
            var semi = left.indexOf(";");
            var name = (semi < 0 ? left : left.slice(0, semi)).toUpperCase();
            var params = semi < 0 ? "" : left.slice(semi + 1);
            if (name === "SUMMARY") cur.summary = unescapeICS(value);
            else if (name === "LOCATION") cur.location = unescapeICS(value);
            else if (name === "DTSTART") cur.start = parseICSDate(value, params);
            else if (name === "DTEND") cur.end = parseICSDate(value, params);
        }
    }
    return events;
}

// True when the event overlaps today's window (in the configured timezone).
function eventInToday(ev, win, today) {
    if (!ev.start) return false;
    if (ev.start.allDay) {
        var t = Date.UTC(today.y, today.mo, today.d);
        var s = Date.UTC(ev.start.y, ev.start.mo, ev.start.d);
        var e = ev.end ? Date.UTC(ev.end.y, ev.end.mo, ev.end.d) : s + 86400000;
        if (e <= s) e = s + 86400000; // guard: single-day feeds with DTEND == DTSTART
        return s <= t && t < e;
    }
    return ev.start.ms >= win.startMs && ev.start.ms < win.endMs;
}

// Format one parsed event as a briefing line (mirrors the workflow Code nodes).
function formatEvent(ev, prefix) {
    var summary = ev.summary || "Untitled Event";
    var location = ev.location || "No location";
    var when;
    if (ev.start.allDay) {
        when = MONTHS[ev.start.mo] + " " + ev.start.d + ", " + ev.start.y + " (All day)";
    } else {
        var s = shifted(ev.start.ms);
        var e = ev.end ? shifted(ev.end.ms) : s;
        when = fmtDate(s) + " " + fmtTime(s) + " - " + fmtTime(e);
    }
    return prefix + summary + " | " + when + " " + CONFIG.tzLabel + " | " + location + "\n";
}

// ── Today window (in the configured timezone) ───────────────────────────────

function todayWindow() {
    var offMs = CONFIG.tzOffsetHours * 3600000;
    var localNow = Date.now() + offMs;
    var localMidnight = localNow - (localNow % 86400000);
    var utcStart = localMidnight - offMs;
    return { startMs: utcStart, endMs: utcStart + 86400000 };
}

// ── Data gatherers ──────────────────────────────────────────────────────────

// Trello: fetch the board's lists and cards, then format the open cards
// (ports the "Get many lists" -> "Get all cards" -> "Code in JavaScript" chain).
function gatherTrello() {
    var t = CONFIG.trello;
    if (!t.enabled || t.apiKey === "" || t.token === "" || t.boardId === "") return "";

    var auth = "key=" + encodeURIComponent(t.apiKey) + "&token=" + encodeURIComponent(t.token);
    var base = "https://api.trello.com/1/boards/" + encodeURIComponent(t.boardId);

    var listsRaw = http.get(base + "/lists?fields=id,name&" + auth);
    var cardsRaw = http.get(base + "/cards?fields=id,name,idList,due,dueComplete,closed,labels&" + auth);
    var lists = null, cards = null;
    try { lists = JSON.parse(listsRaw); } catch (e) { lists = null; }
    try { cards = JSON.parse(cardsRaw); } catch (e) { cards = null; }
    if (!cards || cards.length === 0) return "";

    var listMap = {};
    if (lists) {
        for (var i = 0; i < lists.length; i++) { listMap[lists[i].id] = lists[i].name; }
    }

    var output = "";
    for (var c = 0; c < cards.length; c++) {
        var card = cards[c];
        var listName = listMap[card.idList] || "Unknown List";
        if (card.dueComplete === true || card.closed === true || listName === "Done") continue;

        var cardName = card.name || "Unnamed Card";
        var tags = (card.labels && card.labels.length > 0)
            ? card.labels.map(function (l) { return l.name || l.color; }).join(", ")
            : "No tags";
        var due = card.due
            ? fmtDate(shifted(new Date(card.due).getTime()))
            : "No due date";

        output += "[" + listName + "] " + cardName + " | Tags: " + tags + " | Due: " + due + "\n";
    }
    return output;
}

// Fetch one calendar's ICS feed and format today's events.
function gatherCalendar(cal) {
    if (!cal.enabled || !cal.ics) return "";
    var raw = http.get(cal.ics);
    if (raw === null || raw === "") return "";

    var events = parseICS(raw);
    var win = todayWindow();
    var today = shifted(Date.now());
    var prefix = cal.kind === "work" ? "Working - " : "";

    var out = "";
    for (var i = 0; i < events.length; i++) {
        if (eventInToday(events[i], win, today)) {
            out += formatEvent(events[i], prefix);
        }
    }
    return out;
}

// Build the aggregated briefing text (ports the "Aggr" node's layout).
function buildAggregate() {
    var holidays = "", events = "", work = "";
    for (var i = 0; i < CONFIG.calendars.length; i++) {
        var cal = CONFIG.calendars[i];
        var text = gatherCalendar(cal);
        if (cal.kind === "holiday") holidays += text;
        else if (cal.kind === "work") work += text;
        else events += text;
    }

    var trello = gatherTrello();

    var p = shifted(Date.now());
    var nowLine = "Current user date time: " + new Date().toISOString() +
        ", " + WEEKDAYS[p.wd] + " " + CONFIG.tzLabel + "\n";

    return "假日: \n" + holidays + "\n" +
        "------------------\n 日曆事件: \n" + events + "\n" + work + "\n" +
        "------------------\n Trello 待辦事項:\n" + trello + "\n" +
        "------------------\n" + nowLine;
}

// ── Telegram send + pending-deletion cleanup ────────────────────────────────

function sendMessage(token, chatId, text) {
    var body = text;
    if (CONFIG.parseMode === "MarkdownV2") body = escapeMarkdownV2(text);

    var payload = { chat_id: chatId, text: body, disable_notification: true };
    if (CONFIG.parseMode !== "") payload.parse_mode = CONFIG.parseMode;

    var res = telegramApi(token, "sendMessage", payload);
    if (res.ok !== true && CONFIG.parseMode !== "") {
        res = telegramApi(token, "sendMessage", {
            chat_id: chatId, text: text, disable_notification: true
        });
    }
    return res;
}

// Delete any previously-sent briefings that are now older than deleteAfterMs,
// keeping the rest queued. Replaces the workflow's inline Wait(20h)->Delete.
function cleanupPending(token) {
    var raw = readDBItem(CONFIG.dbTable, "pending");
    var queue = [];
    if (raw && raw !== "false" && raw !== "null") {
        try { queue = JSON.parse(raw); } catch (e) { queue = []; }
    }

    var now = Date.now();
    var remaining = [];
    for (var i = 0; i < queue.length; i++) {
        var item = queue[i];
        if (now - item.sentAt >= CONFIG.deleteAfterMs) {
            telegramApi(token, "deleteMessage",
                { chat_id: item.chatId, message_id: item.messageId });
        } else {
            remaining.push(item);
        }
    }
    return remaining;
}

function queuePush(queue, chatId, messageId) {
    queue.push({ chatId: chatId, messageId: messageId, sentAt: Date.now() });
    writeDBItem(CONFIG.dbTable, "pending", JSON.stringify(queue));
}

// ── Main ────────────────────────────────────────────────────────────────────

function main() {
    var token = getBotToken();
    if (token === "") {
        sendJSONResp({ ok: false, error: "bot token not configured" });
        return;
    }

    // Drain old briefings first (delete anything past its lifetime).
    var queue = cleanupPending(token);

    var briefingData = buildAggregate();

    var reply;
    try {
        reply = llm.chat(CONFIG.promptTemplate + briefingData, {
            model: CONFIG.model,
            max_tokens: CONFIG.maxTokens
        });
    } catch (e) {
        writeDBItem(CONFIG.dbTable, "pending", JSON.stringify(queue));
        sendJSONResp({ ok: false, error: "llm error: " + e });
        return;
    }

    if (!reply || reply === "") {
        writeDBItem(CONFIG.dbTable, "pending", JSON.stringify(queue));
        sendJSONResp({ ok: true, sent: false, note: "empty model reply" });
        return;
    }

    var res = sendMessage(token, CONFIG.chatId, reply);
    if (res.ok === true && res.result && res.result.message_id) {
        queuePush(queue, res.result.chat.id, res.result.message_id);
    } else {
        writeDBItem(CONFIG.dbTable, "pending", JSON.stringify(queue));
    }

    sendJSONResp({ ok: true, sent: res.ok === true });
}

main();
